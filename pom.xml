	<build>
		<plugins>
			<!-- Managed in parent POM -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.14.0</version>
				<configuration>
					<source>${maven.compiler.source}</source>
					<target>${maven.compiler.target}</target>
					<annotationProcessorPaths>
			          <path>
			            <groupId>org.immutables</groupId>
			            <artifactId>value</artifactId> <!-- contains the annotation processor -->
			            <version>${immutables.version}</version>
			          </path>
			        </annotationProcessorPaths>
				</configuration>
			</plugin>

			<!-- Default build is offline + deterministic: live API query tests carry
			     @Category(LiveTest.class) and are excluded here. Run them with
			     ./scripts/run-live-tests.sh (see plan-007-api-test-coverage). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
				<configuration>
					<!-- default build = offline tier only; scripts/run-live-tests.sh clears
					     this via -Dtest.excludedGroups= (an explicit literal here could
					     not be overridden from the command line) -->
					<excludedGroups>${test.excludedGroups}</excludedGroups>
				</configuration>
			</plugin>

			<!-- The runnable artefact is a thin jar beside target/lib, not a fat one.
			     maven-shade used to flatten every dependency into one jar, which silently
			     dropped resources that two jars publish at the same path: GraalJS and its
			     regex language both register through META-INF/truffle/language, only one
			     survived, and every citation render in the built server failed as a result
			     (issue-022). Keeping the dependency jars intact keeps their resources
			     intact, and `java -jar` still works because the manifest names them. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.7.0</version>
				<executions>
					<execution>
						<id>copy-runtime-dependencies</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/lib</outputDirectory>
							<includeScope>runtime</includeScope>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>true</overWriteSnapshots>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- The record model's interfaces refer to the Immutable* classes the
			     Immutables processor generates, and javadoc does not run annotation
			     processors, so without the generated sources on its path every such
			     reference is "cannot find symbol" and the goal stops (debt-012).
			     The goal therefore needs a prior `mvn compile` for those sources to
			     exist; it is not bound to a phase because the whole of this javadoc
			     would be rebuilt on every package.
			     doclint is off deliberately: this project's javadoc is prose, with no
			     @param or @return tags anywhere, and the default doclint warns on
			     every one of them — several hundred lines that bury anything real. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.12.0</version>
				<configuration>
					<sourcepath>${project.basedir}/src/main/java:${project.build.directory}/generated-sources/annotations</sourcepath>
					<doclint>none</doclint>
					<quiet>true</quiet>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.2</version>
				<configuration>
					<archive>
						<manifest>
							<mainClass>uk.co.terminological.bibliography.mcp.McpHttpServer</mainClass>
							<addClasspath>true</addClasspath>
							<classpathPrefix>lib/</classpathPrefix>
						</manifest>
					</archive>
				</configuration>
			</plugin>			
		</plugins>
	</build>
</project>


