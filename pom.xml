<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>io.github.ai4ci</groupId>
	<version>0.2.1</version>
	<artifactId>bibliography-mcp</artifactId>
	<packaging>jar</packaging>
	<name>Bibliographic APIs MCP</name>
	<description>
		Search and crawl the scientific literature
	</description>
	<licenses>
		<license>
			<name>MIT License</name>
			<url>http://www.opensource.org/licenses/mit-license.php</url>
		</license>
	</licenses>
	<developers>
		<developer>
			<name>Rob Challen</name>
			<email>rob.challen@bristol.ac.uk</email>
			<organization>AI4CI, University of Bristol</organization>
			<organizationUrl>https://ai4ci.ac.uk/</organizationUrl>
		</developer>
	</developers>
	<properties>
		<git.repo>ai4ci/bibliography-mcp</git.repo>
		<git.m2repo>ai4ci/bibliography-mcp</git.m2repo>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- 17 because the MCP Java SDK is compiled for it (class file major 61).
		ADR-002's Java 11 constraint is superseded by ADR-006. -->
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<mcp.sdk.version>2.1.0</mcp.sdk.version>
		<sqlite.version>3.50.3.0</sqlite.version>
		<jetty.version>12.1.14</jetty.version>
		<jackson.version.core>2.9.7</jackson.version.core>
		<immutables.version>2.12.3</immutables.version>
		<!-- default offline tier: exclude the live category. scripts/run-live-tests.sh
		overrides this to empty to run only the live tier. -->
		<test.excludedGroups>uk.co.terminological.bibliography.LiveTest</test.excludedGroups>
	</properties>
	<url>https://github.com/${git.repo}</url>
	<scm>
		<connection>scm:git:git@github.com:${git.repo}.git</connection>
		<developerConnection>scm:git:git@github.com:${git.repo}.git</developerConnection>
		<url>https://github.com/${git.repo}</url>
		<tag>HEAD</tag>
	</scm>
	<repositories>
		<repository>
			<id>ai4ci-github</id>
			<url>https://maven.pkg.github.com/${git.m2repo}</url>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
			<releases>
				<enabled>true</enabled>
			</releases>
		</repository>
	</repositories>
	<!-- N.B. repository must be paired with an entry in ~/.m2/settings.xml which
	matches the id above, e.g.

	<settings>
		<servers>
			<server>
				<id>ai4ci-github</id>
				<username>GITHUB_USERNAME</username>
				<password>GITHUB_TOKEN</password>
			</server>
		</servers>
	</settings>

	-->
	<distributionManagement>
		<snapshotRepository>
			<id>github</id>
			<name>GitHub Apache Maven Packages</name>
			<url>https://maven.pkg.github.com/${git.m2repo}</url>
		</snapshotRepository>
		<repository>
			<id>github</id>
			<name>GitHub Apache Maven Packages</name>
			<url>https://maven.pkg.github.com/${git.m2repo}</url>
		</repository>
	</distributionManagement>
	<dependencies>
		<!-- The repository store. SQLite was measured against a JSON-lines log in
		     plan-010: both are fast, but the log's index costs ~550 bytes a record
		     resident, where SQLite answers a top-N query from a cold reader while
		     the crawl is still writing. -->
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<version>${sqlite.version}</version>
		</dependency>
		<!-- The MCP protocol, server side. The aggregator brings mcp-core plus the
		     Jackson 3 binding, whose coordinates (tools.jackson.*) cannot collide with
		     this project's own Jackson 2. See ADR-006. -->
		<dependency>
			<groupId>io.modelcontextprotocol.sdk</groupId>
			<artifactId>mcp</artifactId>
			<version>${mcp.sdk.version}</version>
		</dependency>
		<!-- The SDK's HTTP transports are servlets and jakarta.servlet-api is provided,
		     so the server brings its own container. -->
		<dependency>
			<groupId>org.eclipse.jetty</groupId>
			<artifactId>jetty-server</artifactId>
			<version>${jetty.version}</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.jetty.ee10</groupId>
			<artifactId>jetty-ee10-servlet</artifactId>
			<version>${jetty.version}</version>
		</dependency>
		<dependency>
			<groupId>io.github.terminological</groupId>
			<artifactId>fluentxml</artifactId>
			<version>2.1.0</version>
		</dependency>
		<dependency>
			<groupId>commons-lang</groupId>
			<artifactId>commons-lang</artifactId>
			<version>2.6</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>io.github.terminological</groupId>
			<artifactId>exotic-datatypes</artifactId>
			<version>1.0.0</version>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.12</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>1.7.7</version>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-log4j12</artifactId>
			<version>1.7.7</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.sun.jersey</groupId>
			<artifactId>jersey-client</artifactId>
			<version>1.12</version>
		</dependency>
		<!-- <dependency>
    		<groupId>com.jayway.jsonpath</groupId>
    		<artifactId>json-path</artifactId>
    		<version>2.3.0</version>
		</dependency>-->
		<!-- https://mvnrepository.com/artifact/com.fasterxml.jackson.core/jackson-core -->
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jdk8</artifactId>
			<version>${jackson.version.core}</version>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-core</artifactId>
			<version>${jackson.version.core}</version>
		</dependency>
		<dependency>
			<groupId>org.isomorphism</groupId>
			<artifactId>token-bucket</artifactId>
			<version>1.6</version>
		</dependency>
		<!-- https://mvnrepository.com/artifact/org.ehcache/ehcache -->
		<dependency>
			<groupId>org.ehcache</groupId>
			<artifactId>ehcache</artifactId>
			<version>3.6.2</version>
		</dependency>
		<dependency>
			<groupId>de.undercouch</groupId>
			<artifactId>citeproc-java</artifactId>
			<version>2.0.0</version>
		</dependency>
		<dependency>
			<groupId>org.citationstyles</groupId>
			<artifactId>styles</artifactId>
			<version>2.0.0</version>
		</dependency>
		<dependency>
			<groupId>org.citationstyles</groupId>
			<artifactId>locales</artifactId>
			<version>2.0.0</version>
		</dependency>
		<dependency>
			<groupId>org.jgrapht</groupId>
			<artifactId>jgrapht-core</artifactId>
			<version>1.4.0</version>
		</dependency>
		<dependency>
			<groupId>org.immutables</groupId>
			<artifactId>value-annotations</artifactId>
			<version>${immutables.version}</version>
			<scope>provided</scope>
			<!-- compile only -->
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<!-- Managed in parent POM -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.14.0</version>
				<configuration>
					<source>${maven.compiler.source}</source>
					<target>${maven.compiler.target}</target>
					<generatedSourcesDirectory>${project.build.directory}/generated-sources/annotations</generatedSourcesDirectory>
					<annotationProcessorPaths>
						<path>
							<groupId>org.immutables</groupId>
							<artifactId>value</artifactId>
							<!-- contains the annotation processor -->
							<version>${immutables.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<!-- Default build is offline + deterministic: live API query tests carry
			     @Category(LiveTest.class) and are excluded here. Run them with
			     ./scripts/run-live-tests.sh (see plan-007-api-test-coverage). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
				<configuration>
					<!-- default build = offline tier only; scripts/run-live-tests.sh clears
					     this via -Dtest.excludedGroups= (an explicit literal here could
					     not be overridden from the command line) -->
					<excludedGroups>${test.excludedGroups}</excludedGroups>
				</configuration>
			</plugin>
			<!-- Repackage with dependencies nested as separate jars. Do not shade them:
			     flattening loses duplicate META-INF/truffle/language registrations and
			     breaks citation rendering (issue-022). -->
			<!-- The record model's interfaces refer to the Immutable* classes the
			     Immutables processor generates, and javadoc does not run annotation
			     processors, so without the generated sources on its path every such
			     reference is "cannot find symbol" and the goal stops (debt-012).
			     The goal therefore needs a prior `mvn compile` for those sources to
			     exist; it is not bound to a phase because the whole of this javadoc
			     would be rebuilt on every package.
			     doclint is off deliberately: this project's javadoc is prose, with no
			     @param or @return tags anywhere, and the default doclint warns on
			     every one of them — several hundred lines that bury anything real. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.12.0</version>
				<configuration>
					<sourcepath>${project.basedir}/src/main/java:${project.build.directory}/generated-sources/annotations</sourcepath>
					<doclint>none</doclint>
					<quiet>true</quiet>
				</configuration>
			</plugin>
			<!-- Declare the normal jar plugin first; Spring Boot repackages its output. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.2</version>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<version>4.1.2</version>
				<configuration>
					<mainClass>uk.co.terminological.bibliography.mcp.McpHttpServer</mainClass>
					<includeTools>false</includeTools>
					<excludes>
						<exclude>
							<groupId>org.immutables</groupId>
							<artifactId>value-annotations</artifactId>
						</exclude>
					</excludes>
					<layers>
						<enabled>false</enabled>
					</layers>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-release-plugin</artifactId>
				<version>3.3.1</version>
				<configuration>
					<!-- Customise your tag format (e.g., v1.0.0 instead of artifactId-1.0.0) -->
					<tagNameFormat>v@{project.version}</tagNameFormat>
					<autoVersionSubmodules>true</autoVersionSubmodules>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
