# .sandbox/readonly — paths kept read-only inside the sandbox, one per line.
# The baseline (~/.config/scoder/sandbox/readonly) already covers .github/,
# .claude/, .gitignore and the common lockfiles — do not repeat them here.

# API keys the Java client loads at runtime (ZoteroConfig, CachingApiClient,
# the MCP server, and scripts/mcp-smoke-test.sh all default to this path).
$HOME/.private/apis/secrets.prop

# Sibling source projects: the parent POM and two compile dependencies.
# Each has a .project file, so Eclipse imports them as source projects.
$HOME/Git/m2repo
$HOME/Git/fluentxml
$HOME/Git/exotic-datatypes

# The `loom` CLI (for the using-loom-cli / creating-a-loom-workflow skills).
# Chain: ~/.local/bin/loom -> ~/.bun/bin/loom -> ~/.bun/install/global (where
# `bun link` registers the package) -> the checkout it was linked from, so the
# whole ~/.bun tree is granted. The bun runtime itself is /usr/local/bin/bun.
# loom writes its DuckDB graph to design/.loom/ inside the project, which is
# already read-write.
$HOME/.local/bin/loom
$HOME/.bun
$HOME/Git/loom-cli
